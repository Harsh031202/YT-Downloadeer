# Server Port & Host (Default for Render Web Services is 10000)
PORT=10000
HOST=0.0.0.0
DEBUG=false

# Ephemeral media download directory
DOWNLOAD_DIR=/tmp/ytdlp_jobs

# Maximum simultaneous active downloads
MAX_CONCURRENT_DOWNLOADS=2

# Download and processing job timeout in seconds (e.g. 10 minutes)
JOB_TIMEOUT_SECONDS=600

# Periodic garbage collection sweep interval in seconds
CLEANUP_INTERVAL_SECONDS=180

# Maximum lifespan for completed/abandoned job directories in seconds (15 minutes)
JOB_TTL_SECONDS=900

# Optional custom FFmpeg path or directory (defaults to auto-detection in PATH)
# FFMPEG_LOCATION=/usr/bin/ffmpeg
